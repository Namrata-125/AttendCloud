# AttendCloud .gitignore

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/

# Runtime SQLite Database & Exports (Preserves folder structure via .gitkeep)
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.db-journal
data/*.db-wal
data/*.db-shm
!data/.gitkeep

exports/*.csv
!exports/.gitkeep

# Environment variables & local secrets
.env
.env.local
.env.*.local

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System specific files
Thumbs.db
Desktop.ini
.DS_Store
.Spotlight-V100
.Trashes
# Local database and generated data
data/
exports/

# Python cache and virtual environment
.venv/
__pycache__/
*.py[cod]

# Environment variables and secrets
.env
.env.*
!.env.example